# Private Python service only. Never copy these into browser configuration.
# Same random shared secret as the Node gateway. All accounts can opt in.
FACE_SERVICE_SECRET=
# Base64-encoded 32-byte AES key. Keep it outside the database/backups.
FACE_ENCRYPTION_KEY=
FACE_DB_PATH=face-service/data/trial.sqlite
# Reviewed/licensed local models and exact SHA-256 checksums. No downloads/bypass.
FACE_DETECTOR_MODEL=face-service/models/yunet.onnx
FACE_DETECTOR_SHA256=
FACE_RECOGNIZER_MODEL=face-service/models/sface.onnx
FACE_RECOGNIZER_SHA256=
FACE_PAD_MODEL=face-service/models/minifasnet-v2.onnx
FACE_PAD_SHA256=
# Upstream ensemble's second crop/model; both are required.
FACE_PAD_SECOND_MODEL=face-service/models/minifasnet-v1se.onnx
FACE_PAD_SECOND_SHA256=
# Prepare both exports/checksums with prepare_liveness.py; see docs/face-verification.md.
# Explicitly calibrated acceptance thresholds, each between 0 and 1.
FACE_MATCH_THRESHOLD=
FACE_PAD_THRESHOLD=
