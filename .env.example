# Server-only credentials. Copy to .env.local, then restart npm run dev.
# Use your provider's SMTP credentials/app password; never use VITE_ prefixes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_FROM=

# Public browser configuration; copy from Supabase's Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side names for the authenticated report API (same public values, no service-role key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional signed-in facial-verification trial. Server-only; disabled by default.
# Never use VITE_ prefixes. See docs/face-verification.md.
FACE_PROTOTYPE_ENABLED=false
FACE_APP_ORIGIN=http://127.0.0.1:5173
FACE_SERVICE_URL=http://127.0.0.1:8001
# On Vercel, REMOVE FACE_SERVICE_URL to use this deployment's Python function.
# Keep FACE_SERVICE_SECRET and the Python database/encryption/threshold settings
# in Vercel's server environment; see docs/face-deployment.md.
FACE_SERVICE_SECRET=
# Vercel only: dedicated Postgres role via Supabase's transaction pooler.
FACE_DATABASE_URL=
# Base64-encoded 32-byte AES key. Preserve it across redeploys.
FACE_ENCRYPTION_KEY=
# Explicit evaluated acceptance values; copy existing values only for a development trial.
FACE_MATCH_THRESHOLD=
FACE_PAD_THRESHOLD=

# Optional face sign-in for all enrolled accounts. Node gateway only.
FACE_SIGNIN_ENABLED=false
# Supabase secret API key (sb_secret_...), used by the Node gateway. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported; prefer the secret API key.
